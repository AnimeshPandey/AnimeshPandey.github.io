{# ── casey-coach.njk ── Avatar + hint bubble ── #}
{# Rendered twice: in desktop aside + mobile dock. JS targets both. #}
<div class="casey-coach__card" data-casey-tier="junior" data-casey-state="idle">
  <div class="casey-coach__card-header casey-coach__avatar-wrap">
    <div class="casey-avatar-frame casey-coach__avatar-frame" data-casey-tier="junior">
      <img class="casey-coach__avatar casey-avatar-frame__img"
           src="{{ '/assets/casey/junior/idle.png' | url }}?v=__AP_BUILD_ID__"
           alt="Casey, junior (idle)"
           width="64" height="64"
           data-casey-avatar="true"
           data-casey-frame-ready="1" />
    </div>
    <span class="casey-coach__name">Casey · Junior</span>
  </div>

  <p class="casey-coach__bubble" aria-live="polite" id="{{ caseyIdPrefix | default('') }}casey-bubble">
    Hey! I'm Casey — scroll through the case and I'll chime in with hints.
  </p>

  {# Action chips — rendered by casey-coach.js from casey.json actions array #}
  <div class="casey-coach__actions" role="group" aria-label="Casey's suggested actions" hidden></div>

  <button type="button" class="casey-coach__voice" aria-label="Listen with Casey (text-to-speech)"
          title="Listen with Casey">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
      <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
    </svg>
    <span class="visually-hidden">Listen with Casey</span>
  </button>

  {# Auto-advances through every chapter this case has voice content for,
     at the reader's current tone — hidden by JS when the case has one or
     fewer voice-enabled chapters (nothing to queue). #}
  <button type="button" class="casey-coach__voice-all" aria-label="Listen to whole case"
          title="Listen to whole case" hidden>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="5 3 19 12 5 21 5 3"/>
      <line x1="19" y1="3" x2="19" y2="21"/>
    </svg>
    <span class="visually-hidden">Listen to whole case</span>
  </button>

  {# Cycles the same hint's other reading-level phrasings without changing
     the reader's chosen tone for the rest of the page — hidden by JS when
     the current chapter's hint only has one usable tone. #}
  <button type="button" class="casey-coach__explain" aria-label="Explain differently"
          title="Explain differently" hidden>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="17 1 21 5 17 9"/>
      <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
      <polyline points="7 23 3 19 7 15"/>
      <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
    </svg>
    <span class="visually-hidden">Explain differently</span>
  </button>
</div>
