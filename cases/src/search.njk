---
layout: layouts/casebook-layout.njk
navActive: cases
title: Search — The Frontend Casebook
description: Search cases and the reading library.
noindex: true
hubStyles: true
slug: search
permalink: /search/index.html
---

<div class="casebook-hub casebook-search-page" id="search-page">

  <header class="casebook-hub__hero">
    <h1 class="casebook-hub__title">Search</h1>
    <p class="casebook-hub__subtitle">
      Search across cases and the reading library.
      <a href="{{ '/index.html' | url }}">← Interactive cases</a>
    </p>
  </header>

  <div id="search-casey-bubble"></div>

  <div class="casebook-search__box">
    <label for="casebook-search-input" class="casebook-search__label">Search</label>
    <input
      type="search"
      id="casebook-search-input"
      class="casebook-search__input"
      placeholder="Search cases and the reading library…"
      autocomplete="off"
      aria-describedby="casebook-search-count"
    />
  </div>

  <p id="casebook-search-count" class="casebook-search__count" aria-live="polite"></p>

  <ul id="casebook-search-results" class="casebook-search__results" role="list"></ul>

  <div id="casebook-search-empty" class="hub-empty" hidden aria-live="polite">
    <div class="casey-avatar-frame hub-empty__avatar" data-casey-tier="junior">
      <img class="hub-empty__img casey-avatar-frame__img casey-reaction-chip__img"
           src="{{ '/assets/casey/brand/reactions/curious.png' | url }}?v=__AP_BUILD_ID__"
           alt="Casey — nothing found"
           width="80" height="80"
           loading="lazy" />
    </div>
    <p class="hub-empty__msg">Nothing matches that search.</p>
  </div>

</div>

<script type="application/json" id="search-live-cases">{{ liveCases | dump | safe }}</script>
{% include 'partials/casey-companion-lines.njk' %}
<script src="{{ '/assets/js/casey-companion.js' | url }}" defer></script>
<script src="{{ '/assets/js/casebook-search.js' | url }}" defer></script>
<script src="{{ '/assets/js/casebook-search-page.js' | url }}" defer></script>
