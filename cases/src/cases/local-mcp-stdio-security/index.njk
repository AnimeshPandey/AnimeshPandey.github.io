        <pre class="case-demo__code"><code>// Broken: the child process inherits the ENTIRE parent environment
const child = spawn('node', ['format-server.js'], {
  env: process.env, // AWS_SECRET_ACCESS_KEY, DATABASE_URL, everything — all of it
});
// format-server.js never asked for these, but nothing stops it from reading:
console.log(process.env.AWS_SECRET_ACCESS_KEY); // defined, readable, unrelated to formatting

// Fixed: build an explicit allowlist — only what this server actually needs
const ALLOWED_ENV_KEYS = ['PATH', 'HOME']; // formatting needs a shell PATH, nothing else

const scopedEnv = Object.fromEntries(
  Object.entries(process.env).filter(([key]) => ALLOWED_ENV_KEYS.includes(key))
);

const child = spawn('node', ['format-server.js'], {
  env: scopedEnv, // AWS_SECRET_ACCESS_KEY was never here to leak
});
console.log(process.env.AWS_SECRET_ACCESS_KEY); // undefined inside the child — not present, not readable</code></pre>
