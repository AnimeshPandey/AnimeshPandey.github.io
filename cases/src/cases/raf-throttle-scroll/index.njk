        <pre class="case-demo__code"><code>// Broken: real work runs on every single scroll event
window.addEventListener('scroll', () =&gt; {
  updateHeaderHeight(); // can run 100+ times/sec
});

// Fixed: work coalesces to at most once per animation frame
let ticking = false;
window.addEventListener('scroll', () =&gt; {
  if (ticking) return;
  ticking = true;
  requestAnimationFrame(() =&gt; {
    updateHeaderHeight(); // runs at most once per frame
    ticking = false;
  });
}, { passive: true });</code></pre>
